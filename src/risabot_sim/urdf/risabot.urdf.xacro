<?xml version="1.0" ?>
<robot name="risabot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Physical dimensions -->
  <xacro:property name="chassis_mass" value="1.5"/>
  <xacro:property name="chassis_length" value="0.22"/>
  <xacro:property name="chassis_width" value="0.16"/>
  <xacro:property name="chassis_height" value="0.08"/>

  <xacro:property name="wheel_mass" value="0.1"/>
  <xacro:property name="wheel_radius" value="0.032"/>
  <xacro:property name="wheel_thickness" value="0.025"/>
  
  <xacro:property name="wheelbase" value="0.14"/>
  <xacro:property name="track_width" value="0.15"/>

  <!-- Materials -->
  <material name="blue"><color rgba="0 0 0.8 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${(1/12)*chassis_mass*(chassis_width*chassis_width+chassis_height*chassis_height)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12)*chassis_mass*(chassis_length*chassis_length+chassis_height*chassis_height)}" iyz="0.0"
               izz="${(1/12)*chassis_mass*(chassis_length*chassis_length+chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <!-- Footprint -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Wheels -->
  <xacro:macro name="wheel" params="prefix x_pos y_pos">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_thickness}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${(1/12)*wheel_mass*(3*wheel_radius*wheel_radius+wheel_thickness*wheel_thickness)}" ixy="0" ixz="0"
                 iyy="${(1/12)*wheel_mass*(3*wheel_radius*wheel_radius+wheel_thickness*wheel_thickness)}" iyz="0"
                 izz="${(1/2)*wheel_mass*(wheel_radius*wheel_radius)}"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="rear_left" x_pos="0" y_pos="${track_width/2}"/>
  <xacro:wheel prefix="rear_right" x_pos="0" y_pos="-${track_width/2}"/>
  <xacro:wheel prefix="front_left" x_pos="${wheelbase}" y_pos="${track_width/2}"/>
  <xacro:wheel prefix="front_right" x_pos="${wheelbase}" y_pos="-${track_width/2}"/>

  <!-- Joints -->
  <joint name="rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0 ${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 -${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Steering Links (Front) -->
  <link name="front_left_steer">
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <link name="front_right_steer">
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steer"/>
    <origin xyz="${wheelbase} ${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- servo range limit +/- 50 degrees = 0.87 rad -->
    <limit lower="-0.87" upper="0.87" effort="10.0" velocity="10.0"/>
  </joint>

  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steer"/>
    <origin xyz="${wheelbase} -${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- servo range limit +/- 50 degrees = 0.87 rad -->
    <limit lower="-0.87" upper="0.87" effort="10.0" velocity="10.0"/>
  </joint>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- LiDAR Frame (backward mount, 180 deg yaw offset) -->
  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.02" length="0.02"/></geometry>
      <material name="black"/>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0 0 0.12" rpy="0 0 3.14159265"/>
  </joint>

  <!-- Camera Frame -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.05 0.02"/></geometry>
      <material name="black"/>
    </visual>
    <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.22 0 0.10" rpy="0 0 0"/>
  </joint>
  <!-- Optical frame for camera (Z forward, X right, Y down) -->
  <link name="camera_color_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-${pi/2} 0 -${pi/2}"/>
  </joint>

  <!-- IMU Frame -->
  <link name="imu_link">
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
  </joint>


  <!-- ==================== GAZEBO PLUGINS ==================== -->

  <!-- Ackermann Drive Plugin -->
  <gazebo>
    <plugin filename="ignition-gazebo-ackermann-steering-system" name="ignition::gazebo::systems::AckermannSteering">
      <!-- Steering -->
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <!-- Drive -->
      <left_joint>rear_left_joint</left_joint>
      <right_joint>rear_right_joint</right_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      
      <!-- Geometry -->
      <wheelbase>${wheelbase}</wheelbase>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      
      <!-- Limits -->
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
      <min_acceleration>-1.0</min_acceleration>
      <max_acceleration>1.0</max_acceleration>
      
      <!-- ROS interface -->
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <odom_publisher_frequency>20</odom_publisher_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>
  
  <gazebo>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

  <!-- LiDAR Sensor -->
  <gazebo reference="laser_frame">
    <sensor type="gpu_lidar" name="ydlidar">
      <update_rate>10.0</update_rate>
      <topic>/scan</topic>
      <ignition_frame_id>laser_frame</ignition_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.02</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Camera Sensor -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="astra_camera">
      <update_rate>30.0</update_rate>
      <topic>/camera/color/image_raw</topic>
      <ignition_frame_id>camera_color_optical_frame</ignition_frame_id>
      <camera>
        <!-- ~60 deg horizontal FOV -->
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- IMU Sensor -->
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <update_rate>50.0</update_rate>
      <topic>/imu/data_raw</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

</robot>
