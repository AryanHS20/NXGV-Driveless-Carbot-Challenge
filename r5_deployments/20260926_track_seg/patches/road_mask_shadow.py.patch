+    def _dispatch(self, name: str, msg: Image, coverage: np.ndarray) -> None:
+        """Route a timestamp-matched BEV frame to the classical or seg path."""
+        if not (self._seg_mode and name == 'primary'):
+            self._process_image(name, msg, coverage)
+            return
+        if self._seg_wait is not None:
