+def seg_candidate_from_mask(seg_bev: np.ndarray, coverage: np.ndarray) -> np.ndarray:
+    """Use a BEV-space segmentation mask as the candidate, limited to observed pixels."""
+    if seg_bev is None or seg_bev.ndim != 2:
+        raise RoadMaskError('segmentation candidate must be a single-channel BEV mask')
+    if coverage is None or coverage.shape != seg_bev.shape:
+        raise RoadMaskError('segmentation candidate shape must match the coverage mask')
+    return (((seg_bev > 127) & (coverage > 0)).astype(np.uint8)) * 255
